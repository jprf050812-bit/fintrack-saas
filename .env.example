# PostgreSQL connection string.
# Get this from Neon, Supabase, or Vercel Postgres.
# If your provider gives you both a "pooled" and "direct"/"unpooled" URL,
# use the POOLED one here (important for serverless deploys like Vercel).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Required by NextAuth to sign session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# The canonical URL of your deployment. In local dev:
NEXTAUTH_URL="http://localhost:3000"

# Optional — the AI chatbot works with a rule-based fallback even without this.
OPENAI_API_KEY=""
